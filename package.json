{
  "name": "restaurante-sistema",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de cardapio e gestao do Rincao Lanches",
  "author": "Rincao Lanches",
  "main": "electron/main.js",
  "scripts": {
    "standalone:prep": "node scripts/prepare-standalone.js",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run build && node scripts/prepare-standalone.js && node scripts/make-icon.js && electron-builder --win dir",
    "postdist": "node -e \"require('fs').copyFileSync('LEIA-ME.md','dist/win-unpacked/LEIA-ME.md')\"",
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "setup": "npm install && npx prisma generate && npx prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3",
    "lucide-react": "^1.45.0",
    "next": "^14.2.35",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xml-crypto": "6.3.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "prisma": "^5.18.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
